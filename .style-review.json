{
  "version": 1,
  "include": [
    ".style-review.json",
    "BuildFile.xml",
    "tools/**",
    "interface/**",
    "src/**",
    "plugins/**",
    "python/**",
    "scripts/**",
    "KUCMSSkimmer/makefile",
    "KUCMSSkimmer/include/**",
    "KUCMSSkimmer/src/**",
    "KUCMSSkimmer/python/**",
    "KUCMSSkimmer/tools/**"
